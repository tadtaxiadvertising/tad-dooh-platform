# Single-stage Dockerfile para tad-driver optimizado para Easypanel Free Tier
FROM node:20-alpine

WORKDIR /app

# Runtime deps
RUN apk add --no-cache openssl curl

# Archivos core del monorepo
COPY package.json ./
COPY packages ./packages
COPY apps/driver ./apps/driver

# Instalar dependencias (usa el lockfile local para consistencia)
RUN npm install --legacy-peer-deps --no-audit --no-fund

# Build con vars del entorno de build de Easypanel
ENV NEXT_PUBLIC_PORTAL_TYPE=DRIVER
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

WORKDIR /app/apps/driver
RUN npm run build

WORKDIR /app

# Copiar standalone al lugar correcto y asegurar archivos estáticos
RUN cp -r apps/driver/.next/standalone/* ./ || true
RUN mkdir -p apps/driver/.next/static && cp -r apps/driver/.next/static ./apps/driver/.next/static/
RUN cp -r apps/driver/public ./public 2>/dev/null || true

# Podar devDeps
RUN npm prune --production --force

# Usuario no-root
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 --ingroup nodejs nextjs && \
    chown -R nextjs:nodejs /app
USER nextjs

ENV NODE_OPTIONS="--max-old-space-size=256"
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=5 \
  CMD wget -qO- "http://127.0.0.1:3000/" >/dev/null || exit 1

CMD ["node", "apps/driver/server.js"]