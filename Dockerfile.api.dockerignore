# Git metadata is never needed in the API image build context.
.git
.gitignore

# Dependency directories are restored inside Docker with npm ci.
node_modules
**/node_modules

# Local build/test artifacts.
dist
**/dist
.next
**/.next
coverage
**/coverage
.tmp
*.log
npm-debug.log*

# Local environment and editor state. Never bake secrets into Docker contexts.
.env
.env.*
!.env.example
.vscode
.idea
.DS_Store

# Dockerfile-specific ignore files override the root .dockerignore.
# Keep nested secret exclusions here too, before COPY . . in Dockerfile.api.
**/.env
**/.env.*
**/.envrc
**/.envrc.*
**/id_rsa
**/id_ed25519
**/*.p8
**/*.p12
**/*.pfx
**/*.pem

# Confidential OAuth client JSON and agent attachment directories.
.hermes
**/.hermes
client_secret*.json
**/client_secret*.json
