# Git metadata is never needed in the image build context.
.git
.gitignore

# Dependency directories are restored inside Docker with npm ci.
node_modules
**/node_modules

# Local build/test artifacts.
dist
**/dist
.next
**/.next
coverage
**/coverage
.tmp
*.log
npm-debug.log*

# Local environment and editor state. Never bake secrets into Docker contexts.
.env
.env.*
!.env.example
.vscode
.idea
.DS_Store
