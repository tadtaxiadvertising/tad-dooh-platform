# Driver Portal - Next.js static export with deploy-ready configuration
FROM node:22-alpine AS builder

WORKDIR /app
RUN npm install -g pnpm
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml* ./
RUN pnpm install

COPY apps/driver ./apps/driver
COPY packages/ ./packages/
RUN pnpm run build -w apps/driver

# Production stage with env vars injected at build time
FROM node:22-alpine AS runner

WORKDIR /app

# Build-time public env vars (client-baked by Next.js).
# Defaults only for builds of CI / standalone. Real keys and URL are injected
# at deploy time (EasyPanel) from easypanel-env-template.md.
ARG NEXT_PUBLIC_SUPABASE_URL=https://ltdcdhqixvbpdcitthqf.supabase.co
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_REAL_ANON_KEY
# NEXT_PUBLIC_SUPABASE_ANON_KEY is required at build time
ARG NEXT_PUBLIC_API_URL=https://tad.api.ibusiness.com.do/api

ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_PORTAL_TYPE=DRIVER
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

WORKDIR /app/apps/driver
RUN pnpm run build

WORKDIR /app

# Copy standalone to correct location and ensure static files exist
RUN cp -r apps/driver/.next/standalone/* ./ || true
RUN mkdir -p apps/driver/.next/static && cp -r apps/driver/.next/static/* ./apps/driver/.next/static/ 2>/dev/null || true
RUN cp -r apps/driver/public ./public 2>/dev/null || true

# Note: Do NOT run npm prune --production: this removes symlinks from local
# workspace packages (tad/services, tad/ui) that the standalone cannot resolve.

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 --ingroup nodejs nextjs && \
    chown -R nextjs:nodejs /app
USER nextjs

ENV NODE_OPTIONS="--max-old-space-size=384 --expose-gc"
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

EXPOSE 3000

# Healthcheck: uses PORT env var (EasyPanel passes 80) or default 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
  CMD curl -f -s -o /dev/null "http://127.0.0.1:${PORT:-3000}/" || exit 1

# ENTRYPOINT wrapper: signal-safe + exec on Alpine, compatible with JSON args
COPY --chmod=0755 apps/driver/docker-entrypoint.sh /docker-entrypoint.sh
ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["node", "apps/driver/server.js"]
