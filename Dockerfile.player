# ============================================
# TAD DOOH Player v2 — Vite TypeScript SPA + Nginx Static
# ============================================
# apps/player/src/ contains the full TypeScript source.
# Stage 1 builds static files; Stage 2 serves them via nginx.
#
# BUILD-TIME ENV VARS (passed as --build-arg by EasyPanel):
#   VITE_API_URL          — API Gateway URL
#   VITE_SUPABASE_URL     — Supabase project URL
#   VITE_SUPABASE_ANON_KEY— Supabase anon key (for Realtime)
#
# FIX HISTORY:
# - 404 /assets/player.css: The Service Worker precached a non-existent
# unhashed path. Fixed in sw.ts (shell-only precache + on-demand SWR).
# - Crash-loop (SIGQUIT): Hardened nginx config — explicit daemon off,
# pid path, worker config, robust health endpoint, and proper error
# handling to satisfy EasyPanel health probes.

# --- STAGE 1: Builder ---
FROM node:20-alpine AS builder

# ── Vite build-time env vars (injected by EasyPanel) ──
ARG VITE_API_URL
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY

RUN apk add --no-cache libc6-compat
WORKDIR /app

# Copy player package files for better layer caching
COPY apps/player/package*.json ./
RUN npm install

# Copy player source (src/, vite.config.ts, tsconfig.json)
COPY apps/player/src/ ./src/
COPY apps/player/vite.config.ts ./vite.config.ts
COPY apps/player/tsconfig.json ./tsconfig.json

# Build Vite SPA
RUN npm run build

# --- STAGE 2: Runner (pure nginx static — no Node.js) ---
FROM nginx:1.27-alpine AS runner

# Remove default nginx welcome page and default config
RUN rm -rf /usr/share/nginx/html/* /etc/nginx/conf.d/default.conf

# Copy built Vite SPA assets
COPY --from=builder /app/dist /usr/share/nginx/html

# ── Write main nginx.conf (overrides the image default) ──
# This ensures: daemon off (stays in foreground for Docker), proper PID,
# worker config, and that SIGQUIT/SIGTERM are handled gracefully.
RUN printf '%s\n' \
  'worker_processes auto;' \
  'pid /var/run/nginx.pid;' \
  '' \
  'events {' \
  '    worker_connections 1024;' \
  '}' \
  '' \
  'http {' \
  '    include /etc/nginx/mime.types;' \
  '    default_type application/octet-stream;' \
  '' \
  '    # Logging — stdout/stderr for container capture' \
  '    access_log /dev/stdout;' \
  '    error_log /dev/stderr warn;' \
  '' \
  '    sendfile on;' \
  '    tcp_nopush on;' \
  '    keepalive_timeout 65;' \
  '' \
  '    # Gzip' \
  '    gzip on;' \
  '    gzip_types text/plain text/css application/javascript application/json image/svg+xml;' \
  '    gzip_min_length 1024;' \
  '' \
  '    include /etc/nginx/conf.d/*.conf;' \
  '}' \
  > /etc/nginx/nginx.conf

# ── Write server block (default.conf) ──
RUN printf '%s\n' \
  'server {' \
  '    listen 80;' \
  '    listen [::]:80;' \
  '    server_name _;' \
  '    root /usr/share/nginx/html;' \
  '    index index.html;' \
  '' \
  '    # Easypanel liveness/readiness probe' \
  '    location /health {' \
  '        access_log off;' \
  '        add_header Content-Type application/json;' \
  '        add_header Cache-Control "no-store";' \
  '        return 200 '"'"'{"status":"OK","service":"tad-player"}'"'"';' \
  '    }' \
  '' \
  '    # Vite hashed assets — long-term immutable cache' \
  '    location /assets/ {' \
  '        expires 1y;' \
  '        add_header Cache-Control "public, immutable";' \
  '        try_files $uri =404;' \
  '    }' \
  '' \
  '    # Service Worker — must be served at root, never cached aggressively' \
  '    location = /sw.js {' \
  '        add_header Cache-Control "no-cache, must-revalidate";' \
  '        try_files $uri =404;' \
  '    }' \
  '' \
  '    # SPA fallback — all unknown routes serve index.html' \
  '    location / {' \
  '        try_files $uri $uri/ /index.html;' \
  '        add_header Cache-Control "no-store, must-revalidate";' \
  '    }' \
  '' \
  '    # Custom error page fallback (prevents raw nginx 404 to client)' \
  '    error_page 404 /index.html;' \
  '}' \
  > /etc/nginx/conf.d/default.conf

EXPOSE 80

# Healthcheck — Nginx must respond 200 on /health within 5s
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:80/health || exit 1

# Stay in foreground — Docker/EasyPanel expects PID 1 to be nginx
CMD ["nginx", "-g", "daemon off;"]
