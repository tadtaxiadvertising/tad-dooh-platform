# ============================================
# TAD DOOH Dashboard - Production Monorepo Dockerfile
# ============================================
FROM node:20-alpine AS builder

WORKDIR /app

# Archivos core del monorepo
COPY package.json package-lock.json ./

# Copiar configuración de workspaces
COPY packages ./packages
COPY apps/advertiser ./apps/advertiser

# Instalar con lockfile (builds reproducibles). El rm -rf del lockfile rompia
# la reproducibilidad: cada build Docker podia resolver versiones distintas de
# tailwindcss/postcss y silenciosamente cambiar el output de CSS.
RUN npm install

# INYECCIÓN CRÍTICA DE IDENTIDAD ADVERTISER
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG NEXT_PUBLIC_API_URL

ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_PORTAL_TYPE=ADVERTISER

# Build específico para advertiser
WORKDIR /app/apps/advertiser
RUN npm run build

# ---- Runner (Production) ----
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_OPTIONS="--max-old-space-size=384"
ENV NEXT_PUBLIC_PORTAL_TYPE=ADVERTISER

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Copiar los assets de output standalone con los permisos correctos
COPY --from=builder --chown=nextjs:nodejs /app/apps/advertiser/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/advertiser/.next/static ./apps/advertiser/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/advertiser/public ./apps/advertiser/public
# FIX: Copiar public a la raíz para compatibilidad con el servidor standalone
COPY --from=builder --chown=nextjs:nodejs /app/apps/advertiser/public ./public

USER nextjs

EXPOSE 80
ENV PORT=80
ENV HOSTNAME="0.0.0.0"

# Importante: standalone server queda bajo la ruta apps/advertiser/server.js
CMD ["node", "apps/advertiser/server.js"]
