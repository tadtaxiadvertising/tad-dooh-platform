# Single-stage Dockerfile para tad-driver optimizado para Easypanel Free Tier
# Node >=22 required by @supabase/supabase-js (deprecation warning on Node 20)
FROM node:22-alpine

WORKDIR /app

# Runtime deps
RUN apk add --no-cache openssl curl

# Archivos core del monorepo
COPY package.json package-lock.json ./
COPY tsconfig.base.json ./
COPY packages ./packages
COPY apps/driver ./apps/driver

# Instalar dependencias con lockfile (builds reproducibles). Sin el lockfile,
# npm re-resuelve las ultimas versiones y puede fallar (ej: una dependencia
# transitoria pide una version yanked de @typescript-eslint/scope-manager).
RUN npm install --legacy-peer-deps --no-audit --no-fund

# Build-time public env vars (client-baked por Next.js).
# Defaults solo para builds de CI / standalone. La clave y la URL reales se
# inyectan con el despliegue (EasyPanel) a partir de la plantilla
# easypanel-env-template.md (NEXT_PUBLIC_SUPABASE_ANON_KEY y NEXT_PUBLIC_API_URL).
ARG NEXT_PUBLIC_SUPABASE_URL=https://ltdcdhqixvbpdcitthqf.supabase.co
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_REAL_ANON_KEY
ARG NEXT_PUBLIC_API_URL=https://tad.api.ibusiness.com.do/api

ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_PORTAL_TYPE=DRIVER
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

WORKDIR /app/apps/driver
RUN npm run build

WORKDIR /app

# Copiar standalone al lugar correcto y asegurar archivos estáticos
RUN cp -r apps/driver/.next/standalone/* ./ || true
RUN mkdir -p apps/driver/.next/static && cp -r apps/driver/.next/static/* ./apps/driver/.next/static/ 2>/dev/null || true
RUN cp -r apps/driver/public ./public 2>/dev/null || true

# NO hacer npm prune --production: mata @tad/services,@tad/ui (son workspaces locales)
# El prune elimina symlinks de los packages locales y el standalone no puede resolverlos.

# Usuario no-root
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 --ingroup nodejs nextjs && \
    chown -R nextjs:nodejs /app
USER nextjs

ENV NODE_OPTIONS="--max-old-space-size=384 --expose-gc"
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

EXPOSE 3000

# Healthcheck: usa PORT del entorno (Easypanel pasa 80) o default 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
  CMD curl -f -s -o /dev/null "http://127.0.0.1:${PORT:-3000}/" || exit 1

# ENTRYPOINT wrapper: señal-safe + exec en Alpine, compatible con JSON args
COPY --chmod=0755 apps/driver/docker-entrypoint.sh /docker-entrypoint.sh
ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["node", "apps/driver/server.js"]