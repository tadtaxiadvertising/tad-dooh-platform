# ============================================
# TAD DOOH Admin Dashboard - Monorepo Dockerfile
# ============================================
FROM node:22-alpine AS builder

WORKDIR /app
RUN npm install -g pnpm@9

# Core monorepo configuration & lockfiles
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml* ./
COPY tsconfig.base.json ./

# Internal packages & app files must be copied before install for workspace:* resolution
COPY packages/ ./packages/
COPY apps/ ./apps/

# Install dependencies preserving lockfile integrity
RUN pnpm install --frozen-lockfile

# Build-time public env vars (client-baked by Next.js)
ARG NEXT_PUBLIC_SUPABASE_URL=https://ltdcdhqixvbpdcitthqf.supabase.co
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_REAL_ANON_KEY
ARG NEXT_PUBLIC_API_URL=https://tad.api.ibusiness.com.do/api
ARG BACKEND_INTERNAL_URL=http://tad-api:3000

ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV BACKEND_INTERNAL_URL=$BACKEND_INTERNAL_URL
ENV NEXT_PUBLIC_PORTAL_TYPE=ADMIN
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Build Admin Dashboard (Next.js standalone mode)
RUN pnpm --filter admin run build

# ---- Production Standalone Runner ----
FROM node:22-alpine AS runner
WORKDIR /app

RUN apk add --no-cache curl

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_OPTIONS="--max-old-space-size=384 --expose-gc"
ENV NEXT_PUBLIC_PORTAL_TYPE=ADMIN
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 --ingroup nodejs nextjs

# Copy standalone output and static assets
COPY --from=builder --chown=nextjs:nodejs /app/apps/admin/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/admin/.next/static ./apps/admin/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/admin/public ./apps/admin/public
COPY --from=builder --chown=nextjs:nodejs /app/apps/admin/public ./public
COPY --chmod=0755 apps/admin/docker-entrypoint.sh /docker-entrypoint.sh

USER nextjs

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
  CMD curl -f -s -o /dev/null "http://127.0.0.1:${PORT:-3000}/" || exit 1

ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["node", "apps/admin/server.js"]
