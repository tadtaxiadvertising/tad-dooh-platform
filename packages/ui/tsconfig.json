{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@tad/ui": ["../../packages/ui/index.ts"],
      "@tad/ui/*": ["../../packages/ui/*"]
    }
  },
  "include": ["components/**/*", "hooks/**/*", "lib/**/*", "*.ts", "*.tsx"],
  "exclude": ["node_modules"]
}
