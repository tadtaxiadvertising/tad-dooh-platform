{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2021",
    "outDir": "./dist",
    "declaration": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@tad/permissions": ["permissions-matrix.ts"],
      "@tad/permissions/*": ["permissions-matrix.ts"]
    }
  },
  "include": ["src/**/*", "permissions-matrix.ts"],
  "exclude": ["node_modules", "dist"]
}
