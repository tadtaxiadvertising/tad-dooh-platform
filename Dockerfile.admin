# Single-stage Dockerfile para TAD Admin Dashboard (Easypanel Free Tier)
FROM node:20-alpine

WORKDIR /app

# Runtime deps
RUN apk add --no-cache openssl curl

# Archivos core del monorepo
COPY package.json ./
COPY packages ./packages
COPY apps/admin ./apps/admin

# Instalar dependencias
RUN npm install --legacy-peer-deps --no-audit --no-fund && \
    npm install --legacy-peer-deps --no-save --no-audit --no-fund \
        @sentry/nextjs@^10.46.0 \
        @tanstack/react-query@^5.91.3 \
        date-fns@^4.1.0 \
        framer-motion@^12.38.0 \
        qrcode.react@^4.2.0 \
        recharts@^2.15.0

# Build con vars del entorno
ENV NEXT_PUBLIC_PORTAL_TYPE=ADMIN
ENV NEXT_PUBLIC_SUPABASE_URL=https://ltdcdhqixvbpdcitthqf.supabase.co
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_sa_TwjDpFtkNn93Ynrw5PA_pv3BhfSi
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

WORKDIR /app/apps/admin
RUN npm run build

WORKDIR /app

# Preparar standalone
RUN cp -r apps/admin/.next/standalone/* ./ || true
RUN mkdir -p apps/admin/.next/static && cp -r apps/admin/.next/static/* ./apps/admin/.next/static/ 2>/dev/null || true
RUN cp -r apps/admin/public ./apps/admin/public && cp -r apps/admin/public ./public 2>/dev/null || true

# Podar devDeps
RUN npm prune --production --force

# Usuario no-root
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 --ingroup nodejs nextjs && \
    chown -R nextjs:nodejs /app
USER nextjs

ENV NODE_OPTIONS="--max-old-space-size=256"
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=5 \
  CMD wget -qO- "http://127.0.0.1:3000/" >/dev/null || exit 1

CMD ["node", "apps/admin/server.js"]