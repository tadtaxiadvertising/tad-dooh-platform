{
  "name": "api",
  "version": "0.1.0",
  "description": "Backend API for TAD DOOH Platform - Taxi Advertising Distribution",
  "author": "TAD Dominicana",
  "private": true,
  "license": "PROPRIETARY",
  "scripts": {
    "build": "nest build --path tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "exec node dist/main.js",
    "start:migrate": "sh ./scripts/migrate-safe.sh && node dist/main.js",
    "deploy:migrate": "sh ./scripts/migrate-safe.sh",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:drift:check": "node scripts/check-prisma-drift.cjs",
    "prisma:drift:test": "node --test scripts/prisma-drift-core.test.cjs scripts/prisma-generated-types.test.cjs scripts/prisma-drift-generated.test.cjs scripts/media-mapping-contract.test.cjs",
    "db:target:test": "node --test scripts/check-supabase-target.test.cjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node scripts/assert-local-prisma-migration.cjs && prisma migrate dev",
    "prisma:studio": "prisma studio",
    "clean": "ts-node scripts/clean-db.ts",
    "cleanup:logs": "ts-node scripts/cleanup-old-logs.ts",
    "seed:devices": "ts-node scripts/seed-fleet.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1003.0",
    "@logtail/node": "^0.6.1",
    "@logtail/winston": "^0.5.8",
    "@modelcontextprotocol/sdk": "^1.15.1",
    "@nestjs/axios": "^3.0.2",
    "@nestjs/bull": "^10.0.0",
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.22",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^5.2.0",
    "@prisma/client": "^5.22.0",
    "@sentry/nestjs": "^10.46.0",
    "@sentry/node": "^10.46.0",
    "@sentry/profiling-node": "^10.46.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tad/impact-calculator": "workspace:*",
    "axios": "^1.13.6",
    "bcrypt": "6.0.0",
    "bull": "^4.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "google-auth-library": "^9.0.0",
    "google-spreadsheet": "^5.2.0",
    "googleapis": "^171.4.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "nest-winston": "^1.10.2",
    "nodemailer": "^10.6.0",
    "passport": "^0.7.0",
    "passport-custom": "^1.1.1",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdfmake": "^0.3.7",
    "pg": "^8.20.0",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.1",
    "uuid": "^14.0.0",
    "winston": "^3.19.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.3.100",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.11.19",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pdfmake": "^0.3.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+[.](t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "node_modules"
    ]
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "overrides": {
    "axios": "^1.13.6",
    "path-to-regexp": "0.1.7"
  }
}
