# .dockerignore - Zero-Waste Extreme Optimization for TAD Platform
**
!package.json
!package-lock.json
!apps/**/package.json
!packages/**/package.json
!apps/api/prisma
!apps/api/src
!apps/api/tsconfig.json
!packages/*/src
!packages/*/tsconfig.json

# Build outputs
**/dist
**/.next
**/out
**/build
**/node_modules

# Environment & Secrets
.env*
**/.env*

# Logs & Debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.eslintcache

# Tests
**/tests
**/__tests__
**/*.test.*
**/*.spec.*
**/playwright-report
**/test-results

# Documentation
**/docs
**/README.md
**/CHANGELOG.md

# OS & IDE
.git
.gitignore
.vscode
.idea
.DS_Store
Thumbs.db

# Media & Temporary
**/*.mp4
**/*.webm
**/*.png
**/*.jpg
**/*.jpeg
**/*.pdf
tmp/
temp/
