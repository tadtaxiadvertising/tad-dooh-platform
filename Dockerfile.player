# ============================================
# TAD DOOH Player - Monorepo Dockerfile (Vite + Nginx)
# ============================================
FROM node:22-alpine AS builder

WORKDIR /app
RUN npm install -g pnpm@10.34.9

# Core monorepo configuration & lockfiles
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml* ./
COPY tsconfig.base.json ./

# Internal packages & app files must be copied before install for workspace:* resolution
COPY packages/ ./packages/
COPY apps/ ./apps/

# Install dependencies preserving lockfile integrity
RUN pnpm install --frozen-lockfile

# Build-time Vite public env vars
ARG VITE_API_URL=https://tad.api.ibusiness.com.do/api/v1
ARG VITE_SUPABASE_URL=https://ltdcdhqixvbpdcitthqf.supabase.co
ARG VITE_SUPABASE_ANON_KEY=REPLACE_WITH_REAL_ANON_KEY

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY

# Build Vite player app (outputs to apps/player/dist)
RUN pnpm --filter tad-player run build

# ---- Production Nginx Runner ----
FROM nginx:alpine AS runner
COPY --from=builder /app/apps/player/dist /usr/share/nginx/html

# Static origin liveness only: does not certify API or offline playback.
RUN test -s /usr/share/nginx/html/index.html \
    && test -s /usr/share/nginx/html/sw.js \
    && printf '%s\n' '{"status":"OK"}' > /usr/share/nginx/html/health

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
