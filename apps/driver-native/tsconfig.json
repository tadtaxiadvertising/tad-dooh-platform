{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "lib": ["ESNext"],
    "paths": {
      "@/*": ["./src/*"],
      "@tad/services": ["../packages/services"],
      "@tad/ui": ["../packages/ui"]
    },
    "baseUrl": "."
  },
  "include": ["src/**/*", "app/**/*", "App.tsx"],
  "exclude": ["node_modules"]
}
