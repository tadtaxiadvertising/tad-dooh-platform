# ============================================
# TAD DOOH Player - Vite SPA + Nginx Static
# ============================================
# apps/player is a Vite TypeScript SPA — no Node.js runtime needed.
# Stage 1 builds static files; Stage 2 serves them via nginx.

# --- STAGE 1: Builder ---
FROM node:20-alpine AS builder
RUN apk add --no-cache libc6-compat
WORKDIR /app

# Copy only player package files for better layer caching
COPY apps/player/package*.json ./
RUN npm ci

# Copy player source and build
COPY apps/player/ ./
RUN npm run build

# --- STAGE 2: Runner (pure nginx static — no Node.js) ---
FROM nginx:1.27-alpine AS runner

# Remove default nginx welcome page
RUN rm -rf /usr/share/nginx/html/*

# Copy built Vite SPA assets
COPY --from=builder /app/dist /usr/share/nginx/html

# Write nginx config inline — avoids any external file dependency
RUN printf 'server {\n\
    listen 80;\n\
    listen [::]:80;\n\
    server_name _;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
\n\
    # Easypanel liveness probe\n\
    location /health {\n\
        access_log off;\n\
        add_header Content-Type application/json;\n\
        add_header Cache-Control "no-store";\n\
        return 200 '"'"'{"status":"OK","service":"tad-player"}'"'"';\n\
    }\n\
\n\
    # Vite hashed assets — long-term cache\n\
    location /assets/ {\n\
        expires 1y;\n\
        add_header Cache-Control "public, immutable";\n\
        try_files $uri =404;\n\
    }\n\
\n\
    # SPA fallback\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
        add_header Cache-Control "no-store, must-revalidate";\n\
    }\n\
\n\
    gzip on;\n\
    gzip_types text/plain text/css application/javascript application/json;\n\
    gzip_min_length 1024;\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
