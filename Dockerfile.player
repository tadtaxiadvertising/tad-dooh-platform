# ============================================
# TAD DOOH Player - Vite Static App (Tablet Display)
# ============================================
FROM node:20-alpine AS builder

WORKDIR /app

# Solo necesitamos la app player — NO es parte del workspace de Next.js
COPY apps/player/package.json ./
RUN npm install

# Copiar fuente y compilar con Vite
COPY apps/player ./
RUN npm run build

# ---- Runner: Nginx para servir archivos estáticos ----
FROM nginx:alpine AS runner

# Copiar el output de Vite (por defecto va a /dist)
COPY --from=builder /app/dist /usr/share/nginx/html

# Configuración Nginx mínima para SPA (redirige 404 → index.html)
RUN printf 'server {\n  listen 80;\n  root /usr/share/nginx/html;\n  index index.html;\n  location / {\n    try_files $uri $uri/ /index.html;\n  }\n}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
