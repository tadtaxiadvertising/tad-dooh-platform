# ============================================
# TAD DOOH - Remotion Worker Dockerfile
# ============================================
FROM node:18-bullseye AS builder

WORKDIR /app

# Archivos core del monorepo
COPY package*.json ./

# Copiar la nueva app (tad-remotion)
COPY apps/tad-remotion ./apps/tad-remotion

# Instalar TODO
RUN rm -rf package-lock.json node_modules && npm install

# Build de tad-remotion
WORKDIR /app/apps/tad-remotion
RUN npm run build

# ---- Runner (Production) ----
FROM node:18-bullseye AS runner
WORKDIR /app

# Instalar dependencias necesarias para Chromium / FFmpeg en el runtime
RUN apt-get update && apt-get install -y \
    curl \
    ffmpeg \
    libnss3 \
    libdbus-1-3 \
    libatk1.0-0 \
    libgbm-dev \
    libasound2 \
    libxrandr2 \
    libxext6 \
    libxfixes3 \
    libx11-xcb1 \
    libxcb1 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxshmfence1 \
    libglib2.0-0 \
    libxss1 \
    libatk-bridge2.0-0 \
    libpango-1.0-0 \
    libcairo2 \
    --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

# Copiar Node Modules y código compilado desde el builder
COPY --from=builder /app /app

# Instalar el navegador de Remotion ANTES de podar dependencias
WORKDIR /app/apps/tad-remotion
RUN npx remotion browser ensure

# Podar dependencias para el runtime
WORKDIR /app
RUN npm prune --production --force

ENV NODE_ENV=production
ENV PORT=8000
ENV REMOTION_CONCURRENCY=1


# Remotion necesita al menos 1-2GB para renders pesados.
# En Easypanel, asegúrese de asignar 1024M de RAM.
EXPOSE 8000

# Comando para iniciar el microservicio (usamos node directamente para manejar señales correctamente)
CMD ["node", "dist/index.js"]


