# ============================================
# TAD DOOH Simulator - Production Dockerfile
# CLI stress-test tool for tablet telemetry
# ============================================

FROM node:20-alpine AS runner

WORKDIR /app

# Copy only what the CLI tool needs
COPY apps/tad-simulator/package.json ./apps/tad-simulator/
COPY package.json package-lock.json ./
COPY packages ./packages

# Install dependencies
RUN npm install --legacy-peer-deps

# Copy source code
COPY apps/tad-simulator/src ./apps/tad-simulator/src

# Security: non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 --ingroup nodejs nodejs
USER nodejs

ENV NODE_ENV=production

# The CLI tool starts with node
WORKDIR /app/apps/tad-simulator
CMD ["node", "src/index.js"]