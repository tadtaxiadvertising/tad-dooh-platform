{
  "name": "tad-dooh-platform",
  "version": "0.1.0",
  "description": "Taxi Advertising Distribution - Digital Out-Of-Home Network",
  "author": "TAD Dominicana",
  "license": "PROPRIETARY",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:backend & npm run dev:admin",
    "dev:backend": "npm run start:dev --workspace api",
    "dev:admin": "npm run dev --workspace admin",
    "dev:advertiser": "npm run dev --workspace advertiser",
    "dev:driver": "npm run dev --workspace driver",
    "dev:tablet": "npm run dev --workspace tad-player",
    "dev:driver-native": "cd apps/driver-flutter && flutter run --dart-define-from-file=.env",
    "dev:simulator": "npm run dev --workspace tad-simulator",
    "install:all": "npm install",
    "build": "npm run build --workspaces --if-present --parallel",
    "build:ci": "pnpm -r --parallel build",
    "build:backend": "npm run build --workspace api",
    "build:all": "npm run build --workspaces",
    "start": "npm run start --workspace api",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "keywords": [
    "dooh",
    "advertising",
    "taxi",
    "digital-signage",
    "offline-first"
  ],
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^5.2.0",
    "@prisma/client": "^5.22.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tad/logging": "workspace:*",
    "@tad/services": "workspace:*",
    "@tad/store": "workspace:*",
    "@tad/ui": "workspace:*",
    "axios": "^1.16.1",
    "bcrypt": "6.0.0",
    "chokidar": "^5.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "express": "^4.18.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^5.22.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.1",
    "sonner": "^1.7.2",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@next/eslint-plugin-next": "15.5.28",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/axios": "^0.14.4",
    "@types/node": "^20.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "eslint-import-resolver-node": "0.3.10",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "postcss": "^8.4.31",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.34.9"
}
