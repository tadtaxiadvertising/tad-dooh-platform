# Single-stage Remotion worker - minimal debug
FROM node:20-bullseye-slim

WORKDIR /app

# Debug: list what's in the build context root
RUN ls -la /

# Debug: check tad-remotion exists
RUN ls -la /app/../apps/tad-remotion/ 2>/dev/null || echo "NOT FOUND: /app/../apps/tad-remotion"

# Debug: check dist exists
RUN ls -la /app/../apps/tad-remotion/dist/ 2>/dev/null || echo "dist NOT FOUND"

# Runtime dependencies - skip chromium for now to debug
RUN apt-get update && apt-get install -y \
    curl \
    ffmpeg \
    --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

# Copiar package.json y instalar SOLO production deps
COPY apps/tad-remotion/package.json ./package.json
RUN npm install --omit=dev --no-audit --no-fund

# Copiar build pre-compilado
COPY apps/tad-remotion/dist ./dist

# Debug: verify dist copied
RUN ls -la /app/dist

# Asegurar browser de Remotion (runtime)
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV REMOTION_BROWSER=chromium
ENV CHROMIUM_PATH=/usr/bin/chromium

ENV NODE_ENV=production
ENV NODE_OPTIONS="--max-old-space-size=896"
ENV PORT=8000
ENV REMOTION_CONCURRENCY=1
ENV REMOTION_BROWSER=chromium
ENV CHROMIUM_PATH=/usr/bin/chromium

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=5 \
  CMD curl -fsS "http://127.0.0.1:8000/health" >/dev/null || exit 1

CMD ["node", "dist/index.js"]