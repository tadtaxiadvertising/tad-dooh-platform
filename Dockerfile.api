# Single-stage build optimizado para Easypanel Free Tier (512MB RAM)
# Node >=22 required by @supabase/supabase-js (deprecation warning on Node 20)
FROM node:22-alpine

WORKDIR /app
RUN apk add --no-cache openssl && npm install -g pnpm@10.34.9

# 1. Install ALL deps for API + impact-calculator first (cached layer)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml* ./
COPY apps/ ./apps/
COPY packages/ ./packages/
COPY tsconfig.base.json ./

# Scope install to API + shared packages
RUN pnpm install --filter api... --filter @tad/impact-calculator...

# 2. Copy all source files
COPY . .

# Fail the image build if Prisma migrations were omitted from the Docker context.
RUN test -f ./apps/api/prisma/migrations/20261030_add_driver_auth_user_id/migration.sql

# 3. Build shared packages first (using source files just copied)
RUN pnpm --filter @tad/impact-calculator run build

# 4. Build API
RUN npx prisma generate --schema=./apps/api/prisma/schema.prisma
RUN pnpm --filter api run build

# Runtime config
ENV NODE_ENV=production
ENV NODE_OPTIONS="--max-old-space-size=384 --expose-gc"
ENV PORT=3000

# Security: non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 --ingroup nodejs --home /app nestjs && \
    sed -i 's/\r$//' /app/apps/api/docker-entrypoint.sh && \
    chmod +x /app/apps/api/docker-entrypoint.sh && \
    chown -R nestjs:nodejs /app

USER nestjs

EXPOSE 3000

WORKDIR /app/apps/api
ENTRYPOINT ["/bin/sh", "-c", "exec /app/apps/api/docker-entrypoint.sh"]
