# ============================================
# TAD DOOH - Remotion Worker Dockerfile
# ============================================
FROM node:18-bullseye AS builder

WORKDIR /app

# Archivos core del monorepo
COPY package*.json ./

# Copiar la nueva app (tad-remotion)
COPY apps/tad-remotion ./apps/tad-remotion

# Instalar TODO
RUN rm -rf package-lock.json node_modules && npm install

# Build de tad-remotion
WORKDIR /app/apps/tad-remotion
RUN npm run build

# ---- Runner (Production) ----
FROM node:18-bullseye AS runner
WORKDIR /app

# Instalar dependencias necesarias para Chromium / Puppeteer en el runtime
RUN apt-get update && apt-get install -y \
    libnss3 \
    libdbus-1-3 \
    libatk1.0-0 \
    libgbm-dev \
    libasound2 \
    libxrandr2 \
    libxext6 \
    libxfixes3 \
    libx11-xcb1 \
    libxcb1 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxshmfence1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production

# Copiar Node Modules y código compilado desde el builder
COPY --from=builder /app /app

WORKDIR /app/apps/tad-remotion

EXPOSE 8000

# Comando para iniciar el microservicio
CMD ["npm", "start"]
