generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model User {
  id        String     @id @default(uuid()) @db.Uuid
  email     String     @unique
  password  String
  name      String
  role      String     @default("ADMIN")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  campaigns Campaign[]

  @@map("users")
}

model Device {
  id                String            @id @default(uuid()) @db.Uuid
  deviceId          String            @unique @map("device_id")
  name              String?
  taxiNumber        String?           @map("taxi_number")
  city              String?
  status            SystemStatus      @default(OPERATIVO)
  lastSync          DateTime?         @map("last_sync")
  lastHeartbeat     DateTime?         @map("last_heartbeat")
  batteryLevel      Int?              @default(100) @map("battery_level")
  lastLat           Float?            @map("last_lat")
  lastLng           Float?            @map("last_lng")
  isOnline          Boolean           @default(false) @map("is_online")
  storageUsed       BigInt?           @map("storage_used")
  storageTotal      BigInt?           @map("storage_total")
  appVersion        String?           @map("app_version")
  authToken         String?           @map("auth_token")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  fleet             String?
  lastSeen          DateTime?         @map("last_seen")
  storageFree       String?           @map("storage_free")
  lastPlayback      DateTime?         @map("last_playback")
  playerStatus      String?           @map("player_status")
  lastSyncHash      String?           @map("last_sync_hash")
  lastSyncAt        DateTime?         @map("last_sync_at")
  lastOnline        DateTime?         @map("last_online")
  lastSyncSuccess   Boolean?          @map("last_sync_success")
  driverId          String?           @map("driver_id_text_217")
  events            AnalyticsEvent[]
  campaignMetrics   CampaignMetric[]
  campaigns         DeviceCampaign[]
  commands          DeviceCommand[]
  heartbeats        DeviceHeartbeat[]
  driver            Driver?           @relation(fields: [driverId], references: [id])
  locations         DriverLocation[]
  playbackEvents    PlaybackEvent[]
  assignedCampaigns PlaylistItem[]
  subscriptions     Subscription[]
  isSimulated       Boolean           @default(false) @map("is_simulated")

  connectivityStatus String @default("ONLINE") @map("connectivity_status")

  @@index([status])
  @@index([lastSync])
  @@index([city])
  @@index([lastSeen])
  @@index([driverId])
  @@index([connectivityStatus])
  @@map("devices")
}

model Campaign {
  id                String   @id @default(uuid()) @db.Uuid
  name              String
  advertiser        String
  advertiserId      String?  @map("advertiser_id") @db.Uuid
  description       String?
  status            String   @default("PENDING_PAYMENT")
  active            Boolean  @default(true)
  startDate         DateTime @map("start_date")
  endDate           DateTime @map("end_date")
  version           Int      @default(1)
  isGlobal          Boolean  @default(false) @map("is_global")
  targetAll         Boolean  @default(true) @map("target_all")
  targetCities      Json     @default("[]") @map("target_cities")
  targetCity        String   @default("Global") @map("target_city")
  targetFleets      Json     @default("[]") @map("target_fleets")
  priority          Int      @default(0)
  targetImpressions Int      @default(0) @map("target_impressions")
  budget            Float    @default(0)
  campaignMonths    Int?     @default(1) @map("campaign_months")
  includeProduction Boolean? @default(false) @map("include_production")
  targetUrl         String?  @map("target_url")
  createdById       String?  @db.Uuid @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  facebook          String?
  instagram         String?
  pedidosYaUrl      String?  @map("pedidos_ya_url")
  uberEatsUrl       String?  @map("uber_eats_url")
  websiteUrl        String?  @map("website_url")
  whatsapp          String?
  category          String?  @default("General")
  hasSeenTutorial   Boolean  @default(false) @map("has_seen_tutorial")

  // ── GAP #6: Day-of-Week & Hour-of-Day Scheduling ──
  // JSON arrays: e.g. scheduleDays=["MON","TUE","WED","THU","FRI"], scheduleHours=["06:00","22:00"]
  // When empty/null, campaign plays 24/7 (legacy behavior preserved).
  scheduleDays  String? @default("[]") @map("schedule_days")
  scheduleHours String? @default("[]") @map("schedule_hours")
  // Frequency cap: max impressions per device per hour (0 = unlimited)
  frequencyCap  Int     @default(0) @map("frequency_cap")

  metrics       CampaignMetric[]
  advertiserRef Advertiser?      @relation(fields: [advertiserId], references: [id])
  createdBy     User?            @relation(fields: [createdById], references: [id])
  devices       DeviceCampaign[]
  media         Media[]          @relation("MediaCampaign")
  mediaAssets   MediaAsset[]
  targets       PlaylistItem[]
  playlists     Playlist[]
  videos        Video[]
  targetDrivers Driver[]         @relation("CampaignToDriver")

  @@index([active])
  @@index([status])
  @@index([startDate, endDate])
  @@map("campaigns")
}

model Playlist {
  id         String   @id @default(uuid())
  campaignId String   @map("campaign_id") @db.Uuid
  name       String
  loopType   String   @default("SEQUENTIAL") // SEQUENTIAL | WEIGHTED | SHUFFLE | PRIORITY
  createdAt  DateTime @default(now()) @map("created_at")
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("playlists")
}

model PlaylistItem {
  campaignId String   @map("campaign_id") @db.Uuid
  deviceId   String   @map("device_id")
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  device     Device   @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)

  @@id([campaignId, deviceId])
  @@map("playlist_items")
}

model DeviceCampaign {
  device_id   String @db.Uuid @map("device_uuid_217")
  campaign_id String @db.Uuid
  assigned_at DateTime @default(now())
  campaign    Campaign @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  device      Device   @relation(fields: [device_id], references: [id], onDelete: Cascade)

  @@id([device_id, campaign_id])
  @@index([device_id])
  @@index([campaign_id])
  @@map("device_campaigns")
}

model Media {
  id               String    @id @default(uuid()) @db.Uuid
  name             String?
  filename         String?
  originalFilename String?   @map("original_filename")
  mimeType         String?   @map("mime_type")
  size             BigInt?
  fileSize         BigInt?   @map("file_size")
  durationSeconds  Int?      @map("duration_seconds")
  width            Int?
  height           Int?
  storageKey       String?   @map("storage_key")
  url              String?
  cdnUrl           String?   @map("cdn_url")
  hash             String?
  hashMd5          String?   @map("hash_md5")
  hashSha256       String?   @map("hash_sha256")
  campaign_id      String? @db.Uuid
  status           String    @default("READY")
  createdAt        DateTime  @default(now()) @map("created_at")
  qrUrl            String?   @map("qr_url")
  campaign         Campaign? @relation("MediaCampaign", fields: [campaign_id], references: [id])

  @@index([status])
  @@map("media")
}

model AnalyticsEvent {
  id          String   @id @default(uuid())
  deviceId    String   @map("device_id")
  campaignId  String?  @map("campaign_id")
  mediaId     String?  @map("media_id")
  eventType   String   @map("event_type")
  eventData   String?  @map("event_data")
  lat         Float?
  lng         Float?
  timestamp   DateTime @default(now())
  occurredAt  DateTime @map("occurred_at")
  receivedAt  DateTime @default(now()) @map("received_at")
  processed   Boolean  @default(false)
  isSimulated Boolean  @default(false) @map("is_simulated")
  device      Device   @relation(fields: [deviceId], references: [deviceId])

  @@index([deviceId])
  @@index([campaignId])
  @@index([eventType])
  @@index([occurredAt])
  @@index([processed])
  @@map("analytics_events")
}

model CampaignMetric {
  id                BigInt   @id @default(autoincrement())
  campaignId        String   @map("campaign_id") @db.Uuid
  deviceId          String?  @map("device_id") @db.Uuid
  date              DateTime
  city              String?
  totalImpressions  Int      @default(0) @map("total_impressions")
  totalCompletions  Int      @default(0) @map("total_completions")
  totalErrors       Int      @default(0) @map("total_errors")
  uniqueDevices     Int      @default(0) @map("unique_devices")
  avgCompletionRate Float?   @map("avg_completion_rate")
  createdAt         DateTime @default(now()) @map("created_at")
  campaign          Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  device            Device?  @relation(fields: [deviceId], references: [id])

  @@unique([campaignId, date, city])
  @@index([campaignId])
  @@index([date])
  @@map("campaign_metrics")
}

model DeviceCommand {
  id            String    @id @default(uuid())
  deviceId      String    @map("device_id") @db.Uuid
  commandType   String    @map("command_type")
  commandParams String?   @map("command_params")
  status        String    @default("PENDING")
  createdAt     DateTime  @default(now()) @map("created_at")
  executedAt    DateTime? @map("executed_at")
  result        String?
  expiresAt     DateTime? @map("expires_at")
  device        Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([status])
  @@map("device_commands")
}

model Video {
  id         String   @id @default(uuid())
  campaignId String   @map("campaign_id") @db.Uuid
  title      String
  url        String
  duration   Int
  fileSize   Int?     @map("file_size")
  mimeType   String?  @map("mime_type")
  createdAt  DateTime @default(now()) @map("created_at")
  uploadedAt DateTime @default(now()) @map("uploaded_at")
  qrUrl      String?  @map("qr_url")
  hashMd5    String?  @map("hash_md5")
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("videos")
}

model DeviceHeartbeat {
  id           String   @id @default(uuid())
  deviceId     String   @map("device_id")
  batteryLevel Int?     @map("battery_level")
  storageFree  String?  @map("storage_free")
  timestamp    DateTime @default(now())
  device       Device   @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)

  @@index([deviceId])
  @@map("device_heartbeats")
}

model PlaybackEvent {
  id          String   @id @default(uuid()) @db.Uuid
  deviceId    String   @map("device_id")
  eventType   String   @map("event_type")
  videoId     String   @map("video_id")
  lat         Float?
  lng         Float?
  timestamp   DateTime @default(now())
  isSimulated Boolean  @default(false) @map("is_simulated")
  verified    Boolean  @default(false) @map("verified")
  device      Device   @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)

  @@unique([deviceId, videoId, timestamp])
  @@index([deviceId])
  @@index([timestamp])
  @@index([videoId])
  @@index([verified])
  @@index([deviceId, timestamp(sort: Desc)])
  @@index([eventType, verified, timestamp])
  @@index([videoId, eventType])
  @@map("playback_events")
}

model MediaAsset {
  id               String   @id @default(uuid()) @db.Uuid
  campaignId       String   @map("campaign_id") @db.Uuid
  type             String
  filename         String
  url              String
  fileSize         Int      @map("file_size")
  checksum         String
  duration         Int?
  version          Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at")
  qrUrl            String?  @map("qr_url")
  processingStatus String   @default("ACTIVE") @map("processing_status")
  validationError  String?  @map("validation_error")
  weight           Int      @default(1) @map("weight") // GAP #7: playback weight (1-10), higher = more frequent
  campaign         Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("media_assets")
}

model Fleet {
  id        String   @id @default(uuid())
  name      String   @unique
  city      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("fleets")
}

model Driver {
  id                         String       @id @default(uuid())
  fullName                   String       @map("full_name")
  cedula                     String?      @unique
  phone                      String       @unique
  authUserId                String?      @unique @map("auth_user_id")
  licensePlate               String?      @map("license_plate")
  taxiPlate                  String?      @unique @map("taxi_plate")
  taxiNumber                 String?      @map("taxi_number")
  subscriptionPaid           Boolean      @default(false) @map("subscription_paid")
  subscriptionEnd            DateTime?    @map("subscription_end")
  status                     SystemStatus @default(PENDIENTE_PAGO)
  onboardingStatus           String       @default("PENDING_AGREEMENT") @map("onboarding_status")
  onboardedAt                DateTime     @default(now()) @map("onboarded_at")
  blockedAt                  DateTime?    @map("blocked_at")
  createdAt                  DateTime     @default(now()) @map("created_at")
  updatedAt                  DateTime     @updatedAt @map("updated_at")
  referredBy                 String?      @map("referred_by")
  password                   String?
  level                      String       @default("BASE")
  consecutiveMonthsUnderGoal Int          @default(0) @map("consecutive_months_under_goal")
  referredAdvertisers        Advertiser[] @relation("AdvertiserReferrals")
  identidadVehicular         Json?        @map("identidad_vehicular")
  hardwareConfig             Json?        @map("hardware_config")
  wallet                     Wallet?

  // LEGAL COMPLIANCE: Acceptance of agreements
  insuranceAccepted     Boolean                @default(false) @map("insurance_accepted")
  insuranceAcceptedAt   DateTime?              @map("insurance_accepted_at")
  contractAccepted      Boolean                @default(false) @map("contract_accepted")
  contractAcceptedAt    DateTime?              @map("contract_accepted_at")
  agreementVersion      String?                @map("agreement_version")
  devices               Device[]
  locations             DriverLocation[]
  referredByDriver      Driver?                @relation("DriverReferrals", fields: [referredBy], references: [id])
  referrals             Driver[]               @relation("DriverReferrals")
  payrollPayments       PayrollPayment[]
  subscriptions         Subscription[]
  campaigns             Campaign[]             @relation("CampaignToDriver")
  contractAcceptances   ContractAcceptance[]
  portalRequests        PortalRequest[]
  isSimulated           Boolean                @default(false) @map("is_simulated")
  referralCode          String?                @unique @default(uuid()) @map("referral_code")
  bankAccount           Json?                  @map("bank_account") // @deprecated: Use Wallet.bankInfo instead. Kept for backward compatibility.
  commissions           Commission[]
  telemetryLogs         Telemetry[]            @relation("DriverTelemetry")
  activeAds             ActiveAd[]
  reconciliationReports ReconciliationReport[]

  @@index([status])
  @@index([phone])
  @@index([status, onboardingStatus])
  @@map("drivers")
}

model FinancialTransaction {
  id        String   @id @default(uuid()) @db.Uuid
  type      String
  category  String
  amount    Float
  netAmount Float    @map("net_amount")
  taxAmount Float    @map("tax_amount")
  status    String   @default("PENDING")
  currency  Currency @default(DOP) @map("currency")
  entityId  String?  @map("entity_id")
  reference String?  @unique
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([type])
  @@index([category])
  @@index([status])
  @@index([currency])
  @@index([createdAt])
  @@index([category, createdAt(sort: Desc)])
  @@map("financial_transactions")
}

model PayrollPayment {
  id           String    @id @default(uuid()) @db.Uuid
  driverId     String    @map("driver_id")
  amount       Float
  month        Int
  year         Int
  status       String    @default("PENDING")
  referenceNum String?   @map("reference_num")
  paidAt       DateTime? @map("paid_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  driver       Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)

  penaltyApplied    Boolean @default(false) @map("penalty_applied")
  penaltyPercentage Float   @default(0) @map("penalty_percentage")
  transmissionHours Float   @default(0) @map("transmission_hours")
  activeAds         Int     @default(0) @map("active_ads")
  gpsPoints         Int     @default(0) @map("gps_points")

  @@unique([driverId, month, year])
  @@index([driverId])
  @@index([status])
  @@map("payroll_payments")
}

model Subscription {
  id            String    @id @default(uuid())
  driverId      String    @map("driver_id")
  deviceId      String?   @map("device_id")
  plan          String
  amount        Float     @default(6000.0)
  status        String    @default("PENDING")
  startDate     DateTime  @default(now()) @map("start_date")
  dueDate       DateTime  @map("due_date")
  validUntil    DateTime  @map("valid_until")
  paidAt        DateTime? @map("paid_at")
  paymentMethod String?   @map("payment_method")
  notes         String?
  isSimulated   Boolean   @default(false) @map("is_simulated")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  device        Device?   @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)
  driver        Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([deviceId])
  @@index([status])
  @@index([dueDate])
  @@map("subscriptions")
}

model Advertiser {
  id             String                   @id @default(uuid()) @db.Uuid
  companyName    String                   @map("company_name")
  contactName    String                   @map("contact_name")
  email          String                   @unique
  phone          String?
  status         String                   @default("ACTIVE")
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")
  facebook       String?
  instagram      String?
  productsData   String?                  @default("[]") @map("products_data")
  websiteUrl     String?                  @map("website_url")
  whatsapp       String?
  category       String?                  @default("General")
  pedidosYaUrl   String?                  @map("pedidos_ya_url")
  uberEatsUrl    String?                  @map("uber_eats_url")
  referredBy     String?                  @map("referred_by")
  password       String?
  referrer       Driver?                  @relation("AdvertiserReferrals", fields: [referredBy], references: [id])
  campaigns      Campaign[]
  portalRequests PortalRequest[]
  subscriptions  AdvertiserSubscription[]
  invoices       Invoice[]

  @@index([status])
  @@index([category])
  @@map("advertisers")
}

model PortalRequest {
  id           String      @id @default(uuid())
  advertiserId String?     @map("advertiser_id") @db.Uuid
  driverId     String?     @map("driver_id")
  campaignId   String?     @map("campaign_id")
  type         String
  status       String      @default("PENDING")
  title        String
  description  String?
  data         String?     @default("{}")
  adminNotes   String?     @map("admin_notes")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  advertiser   Advertiser? @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  driver       Driver?     @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([advertiserId])
  @@index([driverId])
  @@index([status])
  @@index([type])
  @@map("portal_requests")
}

model DriverLocation {
  id          String   @id @default(uuid()) @db.Uuid
  driverId    String   @map("driver_id_text_217")
  deviceId    String   @db.Uuid @map("device_id")
  latitude    Float
  longitude   Float
  speed       Float    @default(0)
  timestamp   DateTime @default(now())
  isSimulated Boolean  @default(false) @map("is_simulated")
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  driver      Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)

  // V12.1.3 (B3 PATCH): UNIQUE constraint requerido por SRE para evitar
  // crecimiento ilimitado de filas duplicadas que llevaba al backend con
  // 512MB RAM a OOM. El hook `useBackgroundTelemetry` aplica debounce de 5
  // minutos y la tablet envía coordenadas con timestamps únicos por ciclo.
  // Migración previa `20260110_driver_location_unique` ejecuta dedupe.
  @@unique([deviceId, timestamp], name: "driver_locations_device_timestamp_unique")
  @@index([deviceId, timestamp])
  @@index([driverId, timestamp])
  @@index([driverId, timestamp(sort: Desc)], map: "driver_locations_driver_id_timestamp_desc_idx")
  @@index([driverId])
  @@index([timestamp])
  @@map("driver_locations")
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String   @default("INFO")
  category  String   @default("SYSTEM")
  read      Boolean  @default(false)
  entityId  String?  @map("entity_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([read])
  @@index([category])
  @@index([createdAt])
  @@map("notifications")
}

/// V12.1.4 (B4 PATCH): Tabla de cola de notificaciones para deduplicar
/// mensajes enviados por el CRON de caducidad de campañas.
/// Constraint única evita notificaciones duplicadas por retry/race.
model NotificationQueue {
  id        String   @id @default(uuid())
  type      String
  category  String
  entityId  String
  title     String
  message   String
  sent      Boolean  @default(false)
  sentAt    DateTime? @map("sent_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([type, category, entityId], name: "notification_queue_unique")
  @@index([sent])
  @@index([createdAt])
  @@map("notification_queue")
}

/// V12.1.4 (B4 PATCH): Registro de campañas que expirarán pronto para
/// disparar notificaciones de caducidad a anunciantes.
model CampaignExpiration {
  id                 String    @id @default(uuid()) @db.Uuid
  campaignId         String    @map("campaign_id") @db.Uuid
  advertiserId       String    @map("advertiser_id")
  driverId           String?   @map("driver_id")
  remainingDays      Int       @map("remaining_days")
  notificationSent   Boolean   @default(false) @map("notification_sent")
  scheduledFor       DateTime  @map("scheduled_for")
  notifiedAt         DateTime? @map("notified_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@unique([campaignId], name: "campaign_expiration_campaign_unique")
  @@index([remainingDays])
  @@index([scheduledFor])
  @@map("campaign_expirations")
}

model BiDashboardSnapshot {
  id                  String   @id @default(uuid())
  snapshotDate        DateTime @unique @map("snapshot_date")
  mrr                 Float
  totalDevices        Int      @map("total_devices")
  onlineDevices       Int      @map("online_devices")
  offlineDevices      Int      @map("offline_devices")
  criticalDevices     Int      @map("critical_devices")
  activeCampaigns     Int      @map("active_campaigns")
  totalImpressionsMtd Int      @map("total_impressions_mtd")
  deliveryRateAvg     Float    @map("delivery_rate_avg")
  syncHealthRate      Float    @map("sync_health_rate")

  // METRICAS PARA INVERSIONISTAS (v7.5)
  yieldPerScreen   Float @default(0) @map("yield_per_screen")
  arpu             Float @default(0) @map("arpu")
  churnRate        Float @default(0) @map("churn_rate")
  projectedRevenue Float @default(0) @map("projected_revenue")

  generatedAt DateTime @default(now()) @map("generated_at")

  @@map("bi_dashboard_snapshots")
}

model ReconciliationReport {
  id                  String    @id @default(uuid())
  period              String // YYYY-MM
  driverId            String    @map("driver_id")
  deviceId            String?   @map("device_id")
  subscriptionStatus  String    @map("subscription_status")
  subscriptionDueDate DateTime? @map("subscription_due_date")
  subscriptionAmount  Float     @map("subscription_amount")
  totalPlaybacks      Int       @map("total_playbacks")
  activeCampaigns     Int       @map("active_campaigns")
  revenueContracted   Float     @map("revenue_contracted")
  revenueReceived     Float     @map("revenue_received")
  payrollDue          Float     @map("payroll_due")
  payrollPaid         Float     @map("payroll_paid")
  hasDiscrepancy      Boolean   @default(false) @map("has_discrepancy")
  discrepancyType     String    @default("OK") @map("discrepancy_type")
  discrepancyAmount   Float     @default(0) @map("discrepancy_amount")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  driver              Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([period, driverId], name: "period_driverId")
  @@index([period])
  @@index([driverId])
  @@map("reconciliation_reports")
}

model ContractAcceptance {
