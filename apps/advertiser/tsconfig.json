{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "target": "ES2017",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@tad/types": [
        "../../packages/types/index.ts"
      ],
      "@tad/types/*": [
        "../../packages/types/*"
      ],
      "@tad/services": [
        "../../packages/services/index.ts"
      ],
      "@tad/services/*": [
        "../../packages/services/*"
      ],
      "@tad/ui": [
        "../../packages/ui/index.ts"
      ],
      "@tad/ui/*": [
        "../../packages/ui/*"
      ],
      "@tad/store": [
        "../../packages/store/index.ts"
      ],
      "@tad/store/*": [
        "../../packages/store/*"
      ],
      "@tad/logging": [
        "../../packages/logging/index.ts"
      ],
      "@tad/logging/*": [
        "../../packages/logging/*"
      ],
      "@tad/impact-calculator": [
        "../../packages/impact-calculator/index.ts"
      ],
      "@tad/impact-calculator/*": [
        "../../packages/impact-calculator/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": true,
    "jsx": "preserve",
    "strictNullChecks": true
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
