# ============================================
# TAD DOOH Dashboard - Production Monorepo Dockerfile
# ============================================
FROM node:20-alpine AS builder

WORKDIR /app

# Archivos core del monorepo
COPY package.json ./

# Copiar configuración de workspaces
COPY packages ./packages
COPY apps/driver ./apps/driver

# Instalar TODO (para resolver las dependencias cruzadas como @tad/services)
RUN rm -rf package-lock.json node_modules && npm install

# INYECCIÓN CRÍTICA DE IDENTIDAD DRIVER
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG NEXT_PUBLIC_API_URL

ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_PORTAL_TYPE=DRIVER

# Build específico para driver
WORKDIR /app/apps/driver
RUN npm run build

# ---- Runner (Production) ----
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_OPTIONS="--max-old-space-size=256"
ENV NEXT_PUBLIC_PORTAL_TYPE=DRIVER

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Los archivos standalone de Next.js en un monorepo se estructuran así:
# apps/driver/server.js
# node_modules/
# .next/static e imágenes deben estar disponibles para el server.

# Copiamos los archivos y aseguramos que el usuario nextjs sea el dueño
COPY --from=builder --chown=nextjs:nodejs /app/apps/driver/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/driver/.next/static ./apps/driver/.next/static

# FIX: El servidor standalone de Next.js sirve archivos estáticos desde
# ./public RELATIVO al WORKDIR (/app). En monorepo, el path real es /app/apps/driver/public,
# pero server.js lo busca en /app/public. Copiamos a ambas rutas.
COPY --from=builder --chown=nextjs:nodejs /app/apps/driver/public ./apps/driver/public
COPY --from=builder --chown=nextjs:nodejs /app/apps/driver/public ./public

USER nextjs

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "apps/driver/server.js"]
