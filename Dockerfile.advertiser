# ============================================
# TAD DOOH Dashboard - Production Monorepo Dockerfile
# ============================================
FROM node:20-alpine AS builder

WORKDIR /app

# Archivos core del monorepo
COPY package.json ./


# Copiar configuración de workspaces
COPY packages ./packages
COPY apps/advertiser ./apps/advertiser

# Instalar TODO (para resolver dependencias como @tad/services)
RUN rm -rf package-lock.json node_modules && npm install

# INYECCIÓN CRÍTICA DE IDENTIDAD ADVERTISER
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG NEXT_PUBLIC_API_URL

ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_PORTAL_TYPE=ADVERTISER

# Build específico para advertiser
WORKDIR /app/apps/advertiser
RUN npm run build

# ---- Runner (Production) ----
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_OPTIONS="--max-old-space-size=1024"
ENV NEXT_PUBLIC_PORTAL_TYPE=ADVERTISER

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Copiar los assets de output standalone
COPY --from=builder /app/apps/advertiser/.next/standalone ./
COPY --from=builder /app/apps/advertiser/.next/static ./.next/static
COPY --from=builder /app/apps/advertiser/public ./public

USER nextjs

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Importante: standalone server queda bajo la ruta apps/advertiser/server.js
CMD ["sh", "-c", "if [ -f apps/advertiser/server.js ]; then mkdir -p apps/advertiser/.next && cp -r .next/static apps/advertiser/.next/ && cp -r public apps/advertiser/ && node apps/advertiser/server.js; elif [ -f server.js ]; then node server.js; else echo 'No server.js found!' && find . -name server.js && exit 1; fi"]
