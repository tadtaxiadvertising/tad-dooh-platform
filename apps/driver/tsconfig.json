{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "incremental": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "forceConsistentCasingInFileNames": true,
    "typeRoots": [
      "./node_modules/@types",
      "../../node_modules/@types"
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@tad/types": [
        "../../packages/types/index.ts"
      ],
      "@tad/types/*": [
        "../../packages/types/*"
      ],
      "@tad/ui": [
        "../../packages/ui/index.ts"
      ],
      "@tad/ui/*": [
        "../../packages/ui/*"
      ],
      "@tad/services": [
        "../../packages/services/index.ts"
      ],
      "@tad/services/*": [
        "../../packages/services/*"
      ],
      "@tad/store": [
        "../../packages/store/index.ts"
      ],
      "@tad/store/*": [
        "../../packages/store/*"
      ],
      "@tad/logging": [
        "../../packages/logging/index.ts"
      ],
      "@tad/logging/*": [
        "../../packages/logging/*"
      ]
    },
    "allowJs": true
  },
  "include": [
    "next-env.d.ts",
    "pages/**/*.ts",
    "pages/**/*.tsx",
    "contexts/**/*.ts",
    "contexts/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "hooks/**/*.ts",
    "hooks/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "services/**/*.ts",
    "services/**/*.tsx",
    "types/**/*.ts",
    "types/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "tests/e2e",
    "apps",
    ".next"
  ]
}
