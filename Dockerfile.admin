# ============================================
# TAD DOOH Dashboard - Production Monorepo Dockerfile
# ============================================
FROM node:20-alpine AS builder

WORKDIR /app

# Archivos core del monorepo
COPY package.json ./


# Copiar configuración de workspaces
COPY packages ./packages
COPY apps/admin ./apps/admin

# Instalar TODO (para resolver las dependencias cruzadas como @tad/services)
RUN rm -rf package-lock.json node_modules && npm install

# INYECCIÓN CRÍTICA DE IDENTIDAD ADMIN
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG NEXT_PUBLIC_API_URL

ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_PORTAL_TYPE=ADMIN

# Build específico para admin
WORKDIR /app/apps/admin
RUN npm run build

# ---- Runner (Production) ----
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_OPTIONS="--max-old-space-size=1024"
ENV NEXT_PUBLIC_PORTAL_TYPE=ADMIN

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Los archivos standalone de Next.js se generan en apps/admin/.next/standalone/apps/admin (por ser monorepo)
# o simplemente en /app/apps/admin/.next/standalone
COPY --from=builder /app/apps/admin/.next/standalone ./
COPY --from=builder /app/apps/admin/.next/static ./.next/static
COPY --from=builder /app/apps/admin/public ./public

USER nextjs

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Importante: Como es root del monorepo, Next.js pone el server.js dentro de apps/admin/server.js dentro de standalone
CMD ["sh", "-c", "if [ -f apps/admin/server.js ]; then mkdir -p apps/admin/.next && cp -RT .next/static apps/admin/.next/static && cp -RT public apps/admin/public && node apps/admin/server.js; elif [ -f server.js ]; then node server.js; else echo 'No server.js found!' && find . -name server.js && exit 1; fi"]
