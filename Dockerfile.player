# ============================================
# TAD DOOH Player - Next.js 15 Standalone + Nginx Proxy
# ============================================

# --- STAGE 1: Builder ---
FROM node:22-alpine AS builder
RUN apk add --no-cache openssl libc6-compat
WORKDIR /app

# Copiar configuración del monorepo y dependencias
COPY package*.json ./
COPY packages ./packages
# Se asume que el código del Player (Next.js 15) está en apps/player o frontend
COPY apps/player ./apps/player

RUN npm install

# Aplicar la configuración standalone que creamos
COPY frontend/next.config.mjs ./apps/player/next.config.mjs

WORKDIR /app/apps/player
RUN npm run build

# --- STAGE 2: Runner ---
FROM node:22-alpine AS runner
RUN apk add --no-cache nginx openssl curl
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Copiar el output standalone de Next.js
# Nota: La estructura standalone pone el server.js en la raíz de la app
COPY --from=builder /app/apps/player/.next/standalone ./
COPY --from=builder /app/apps/player/.next/static ./.next/static
COPY --from=builder /app/apps/player/public ./public

# Copiar configuraciones de Nginx y entrada
COPY nginx/conf.d/default.conf /etc/nginx/conf.d/default.conf
COPY docker-entrypoint-tad.sh /usr/local/bin/docker-entrypoint-tad.sh
RUN chmod +x /usr/local/bin/docker-entrypoint-tad.sh

EXPOSE 80

# Usamos el entrypoint híbrido para lanzar Node y Nginx
ENTRYPOINT ["/usr/local/bin/docker-entrypoint-tad.sh"]
