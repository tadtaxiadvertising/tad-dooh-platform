# ============================================
# TAD DOOH - Remotion Worker Dockerfile
# ============================================
FROM node:20-bullseye AS builder

WORKDIR /app

# Archivos core del monorepo
COPY package*.json ./
# Copiar el package.json de la app para que npm install lo reconozca como workspace
COPY apps/tad-remotion/package.json ./apps/tad-remotion/
COPY libs ./libs

# Instalar dependencias
RUN npm install

# Copiar el resto de la app
COPY apps/tad-remotion ./apps/tad-remotion

# Build de tad-remotion
WORKDIR /app/apps/tad-remotion
RUN npm run build

# Descargar el navegador de Remotion en el builder
# Aquí los node_modules ya están instalados correctamente.
# Probamos múltiples rutas posibles según donde npm haya colocado el binario.
WORKDIR /app
RUN /app/node_modules/.bin/remotion browser ensure \
    || /app/apps/tad-remotion/node_modules/.bin/remotion browser ensure \
    || node -e "require('@remotion/renderer').ensureBrowser().then(()=>console.log('Browser ready')).catch(e=>{console.error(e);process.exit(1)})"

# ---- Runner (Production) ----
FROM node:20-bullseye AS runner
WORKDIR /app

# Instalar dependencias necesarias para Chromium / FFmpeg en el runtime
RUN apt-get update && apt-get install -y \
    curl \
    ffmpeg \
    libnss3 \
    libdbus-1-3 \
    libatk1.0-0 \
    libgbm-dev \
    libasound2 \
    libxrandr2 \
    libxext6 \
    libxfixes3 \
    libx11-xcb1 \
    libxcb1 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxshmfence1 \
    libglib2.0-0 \
    libxss1 \
    libatk-bridge2.0-0 \
    libpango-1.0-0 \
    libcairo2 \
    --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

# Copiar app desde el builder (incluyendo node_modules)
COPY --from=builder /app /app

# Copiar la caché del navegador descargado en el builder
# Remotion/Puppeteer guarda el binario de Chromium en /root/.cache
COPY --from=builder /root/.cache /root/.cache

# Podar dependencias para el runtime
WORKDIR /app
RUN npm prune --production --force

ENV NODE_ENV=production
ENV PORT=8000
ENV REMOTION_CONCURRENCY=1

# Remotion necesita al menos 1-2GB para renders pesados.
# En Easypanel, asegúrese de asignar 1024M de RAM.
EXPOSE 8000

# Comando para iniciar el microservicio
CMD ["node", "apps/tad-remotion/dist/index.js"]
