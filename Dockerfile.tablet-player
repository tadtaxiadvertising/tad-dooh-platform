# ============================================
# TAD DOOH Tablet Player - HTML Estático con Nginx
# ============================================
FROM nginx:alpine

# Copiar archivos estáticos directamente desde el contexto de build
# EasyPanel debe tener Build Path = / (raíz del monorepo)
COPY apps/tablet-player /usr/share/nginx/html

# Configuración Nginx que sirve directamente el HTML
RUN printf 'server {\n  listen 80;\n  root /usr/share/nginx/html;\n  index index.html;\n  location / {\n    try_files $uri $uri/ /index.html;\n  }\n  # Permitir acceso a los archivos estáticos\n  location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|webmanifest)$ {\n    expires 1y;\n    add_header Cache-Control "public, immutable";\n  }\n}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
