# Single-stage build optimizado para Easypanel Free Tier (512MB RAM)
# Node >=22 required by @supabase/supabase-js (deprecation warning on Node 20)
FROM node:22-alpine

WORKDIR /app
RUN apk add --no-cache openssl

# 1. Install ALL deps for API + impact-calculator first (cached layer)
COPY package.json pnpm-lock.yaml ./
COPY apps/api/package.json ./apps/api/
COPY apps/api/prisma/ ./apps/api/prisma/
COPY packages/ ./packages/
COPY tsconfig.base.json ./

# Scope install to API + shared packages (pnpm install --workspace; lockfile stays in sync)
RUN pnpm install --workspace=apps/api --workspace=packages/impact-calculator --no-audit --no-fund

# 2. Copy all source files
COPY . .

# 3. Build shared packages first (using source files just copied)
RUN pnpm run build --workspace=packages/impact-calculator

# 4. Build API
RUN npx prisma generate --schema=./apps/api/prisma/schema.prisma
RUN pnpm run build -w apps/api

# 5. Prune devDependencies (but keep node_modules structure)
RUN pnpm prune --omit=dev --workspace=apps/api

# Runtime config
ENV NODE_ENV=production
ENV NODE_OPTIONS="--max-old-space-size=384 --expose-gc"
ENV PORT=3000

# Security: non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 --ingroup nodejs --home /app --shell /sbin/nologin nodejs

USER nodejs

EXPOSE 3000

CMD ["node", "dist/main.js"]
