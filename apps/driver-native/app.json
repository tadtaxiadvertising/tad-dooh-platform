{
  "expo": {
    "name": "TAD Driver",
    "slug": "tad-driver-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tad-driver",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0a0a0a"
    },
    "android": {
      "package": "com.tad.dooh.driver",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a",
        "foregroundImage": "./assets/icon.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "WAKE_LOCK",
        "INTERNET",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "softwareKeyboardLayoutMode": "pan"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-location",
        {
          "isAndroidForegroundService": true,
          "androidBackgroundLocationPermissionDetail": {
            "message": "TAD necesita tu ubicación para trackear tu ruta y asignar campañas activas.",
            "title": "Ubicación en segundo plano",
            "detail": "Tu ubicación se envía cada 5 minutos para sincronizar la flota."
          }
        }
      ],
      [
        "expo-keep-awake",
        {
          "androidKeepScreenOn": true
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
