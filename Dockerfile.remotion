# Single-stage Remotion worker optimizado para Easypanel (1024MB RAM disponible)
FROM node:20-bullseye-slim

WORKDIR /app

# Runtime dependencies mínimas para Chromium
RUN apt-get update && apt-get install -y \
    curl \
    ffmpeg \
    chromium \
    --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

# Archivos SOLO de tad-remotion (evita problemas del monorepo)
COPY apps/tad-remotion/package.json ./package.json

# Instalar dependencias + devDeps para build
RUN npm install --no-audit --no-fund

# Copiar código fuente
COPY apps/tad-remotion/tsconfig.json ./tsconfig.json
COPY apps/tad-remotion/src ./src

# Build
RUN npm run build

# Remover devDeps después del build
RUN npm prune --omit=dev --force

# Asegurar browser de Remotion
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV REMOTION_BROWSER=chromium
ENV CHROMIUM_PATH=/usr/bin/chromium
RUN node -e "try{require('@remotion/renderer').ensureBrowser().then(()=>console.log('Browser ready')).catch(e=>console.log('Browser check skipped:',e.message))}catch(e){console.log('Browser check error:',e.message)}"

ENV NODE_ENV=production
ENV NODE_OPTIONS="--max-old-space-size=896"
ENV PORT=8000
ENV REMOTION_CONCURRENCY=1
ENV REMOTION_BROWSER=chromium
ENV CHROMIUM_PATH=/usr/bin/chromium

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=5 \
  CMD curl -fsS "http://127.0.0.1:8000/health" >/dev/null || exit 1

CMD ["node", "dist/index.js"]