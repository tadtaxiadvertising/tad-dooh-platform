# Git metadata is never needed in the image build context.
.git
.gitignore

# Dependency directories are restored inside Docker with npm ci.
node_modules
**/node_modules

# Local build/test artifacts.
.next
**/.next
coverage
**/coverage
.tmp
*.log
npm-debug.log*

# Local environment and editor state.
.env
.env.*
!.env.example
!*.env.example
.env.local
.env.*.local
.vscode
.idea
.DS_Store

# Defence in depth: Docker copies the whole monorepo. Exclude every nested
# environment file even when checked out accidentally on a build runner.
**/.env
**/.env.*
**/.envrc
**/.envrc.*
**/id_rsa
**/id_ed25519
**/*.p8
**/*.p12
**/*.pfx
**/*.pem
