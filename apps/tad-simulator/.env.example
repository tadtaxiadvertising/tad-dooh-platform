# ============================================
# TAD Simulator - Environment Variables
# ============================================

# --- Persistencia Local del Simulador ---
# Database interna para guardar Escenarios, Sesiones y Latencias (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/tad_simulator?schema=public"

# --- Conexión con TAD API (Target) ---
# URL de la tad-api a la que el simulador enviará los batches de GPS y Playbacks
TAD_API_URL="http://localhost:3000/api/v1"
TAD_API_KEY="xxx-sim-secret-xxx" # API Key para bypass de rate-limiting

# --- Supabase (Visualización Map/Realtime) ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJh..." 
SUPABASE_SERVICE_ROLE_KEY="eyJh..." 

# --- Parámetros Iniciales del Engine ---
DEFAULT_DRIVER_COUNT=150
DEFAULT_TELEMETRY_FREQ=30
MAX_LATENCY_THRESHOLD=200 # ms para disparar alerta de Cuello de Botella

# --- Configuración Base ---
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
# Límite de memoria para Node (Optimizado para 1GB RAM)
NODE_OPTIONS="--max-old-space-size=768"
