# ============================================
# TAD DOOH Player - Vite SPA + Nginx Static
# ============================================
# apps/player is a Vite TypeScript SPA — no Node.js server needed at runtime.
# Stage 1 builds the static files; Stage 2 serves them via nginx.

# --- STAGE 1: Builder ---
FROM node:20-alpine AS builder
RUN apk add --no-cache openssl libc6-compat
WORKDIR /app

# Copy only player package files for better cache utilization
COPY apps/player/package*.json ./
RUN npm ci --only=production=false

# Copy player source
COPY apps/player/ ./

# Build the Vite SPA → outputs to /app/dist
RUN npm run build

# --- STAGE 2: Runner (pure nginx static) ---
FROM nginx:1.27-alpine AS runner

# Remove default nginx welcome page
RUN rm -rf /usr/share/nginx/html/*

# Copy built static assets from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy our custom nginx config (health endpoint + SPA fallback)
COPY nginx/conf.d/player.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# nginx runs as PID 1 in foreground — Easypanel monitors this directly
CMD ["nginx", "-g", "daemon off;"]
