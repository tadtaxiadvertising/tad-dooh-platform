FROM node:20-alpine AS builder
WORKDIR /app

# Optimize build process: Cache node_modules
COPY apps/admin/package*.json ./
RUN npm install

# Finalize source code
COPY apps/admin/ .

# INYECCIÓN CRÍTICA DE IDENTIDAD ADMIN (FORCED AT BUILD)
ENV NEXT_PUBLIC_PORTAL_TYPE=ADMIN

# Build standalone Next.js 15
RUN npm run build

# Stage 2: Production Execution
FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_PUBLIC_PORTAL_TYPE=ADMIN
# 8GB VPS optimization (High heap for analytics & map clusters)
ENV NODE_OPTIONS="--max-old-space-size=1024"

# Standalone execution
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public

EXPOSE 3000
CMD ["node", "server.js", "-p", "3000"]
