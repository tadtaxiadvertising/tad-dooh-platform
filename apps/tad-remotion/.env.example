# ──────────────────────────────────────────────
# TAD Remotion Engine - Ejemplo de Configuración
# ──────────────────────────────────────────────

# Puerto del servidor (default: 8000)
PORT=8000

# Entorno: development | production
NODE_ENV=development

# ─── Remotion ─────────────────────────────────
# Concurrencia para renderizado (1-4, recomendado: 1)
REMOTION_CONCURRENCY=1

# ─── Google Gemini AI ─────────────────────────
# Necesaria para el AI Architect (generación de anuncios)
# Obtén tu API Key en: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ─── (Opcional) Ruta de NPM ──────────────────
# Solo necesario en Windows si Remotion CLI no encuentra npm
# REMOTION_NPM_PATH=C:\Program Files\nodejs\npm.cmd