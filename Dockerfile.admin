# ============================================
# TAD DOOH Dashboard - Production Monorepo Dockerfile
# ============================================
FROM node:20-alpine AS builder

WORKDIR /app

# Archivos core del monorepo
COPY package.json ./


# Copiar configuración de workspaces
COPY packages ./packages
COPY apps/admin ./apps/admin

# Instalar TODO (para resolver las dependencias cruzadas como @tad/services).
# EasyPanel only copies apps/admin plus shared packages into this image, so
# install the admin-only runtime imports that are currently provided by other
# workspaces/root installs in development. Keep this in the Dockerfile instead
# of changing package-lock.json because this image intentionally deletes the
# lockfile before installing.
RUN rm -rf package-lock.json node_modules \
    && npm install --legacy-peer-deps --no-audit --no-fund \
    && npm install --legacy-peer-deps --no-save --no-audit --no-fund \
        @sentry/nextjs@^10.46.0 \
        @tanstack/react-query@^5.91.3 \
        date-fns@^4.1.0 \
        framer-motion@^12.38.0 \
        qrcode.react@^4.2.0 \
        recharts@^2.15.0

# INYECCIÓN CRÍTICA DE IDENTIDAD ADMIN
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG NEXT_PUBLIC_API_URL

ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_PORTAL_TYPE=ADMIN

# Build específico para admin
WORKDIR /app/apps/admin
RUN npm run build

# ---- Runner (Production) ----
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_OPTIONS="--max-old-space-size=256"
ENV NEXT_PUBLIC_PORTAL_TYPE=ADMIN

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Los archivos standalone de Next.js en un monorepo se estructuran así:
# apps/admin/server.js
# node_modules/
# .next/static e imágenes deben estar disponibles para el server.

# Copiamos los archivos y aseguramos que el usuario nextjs sea el dueño
# FIX: Copiar public a ambas rutas para compatibilidad con el servidor standalone
COPY --from=builder --chown=nextjs:nodejs /app/apps/admin/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/admin/.next/static ./apps/admin/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/admin/public ./apps/admin/public
COPY --from=builder --chown=nextjs:nodejs /app/apps/admin/public ./public

USER nextjs

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "apps/admin/server.js"]
